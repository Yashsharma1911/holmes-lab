export KUBECONFIG="$PWD/kubeconfig.yaml"
export DIGITALOCEAN_ACCESS_TOKEN=dop_v1_xxx          # Kubernetes read scope is enough
# LLM: DigitalOcean serverless inference (OpenAI-compatible)
export OPENAI_API_BASE=https://inference.do-ai.run/v1
export OPENAI_API_KEY=doo_v1_xxx
export MODEL=openai/anthropic-claude-sonnet-5.5
export PYTHONWARNINGS=ignore
export HOLMES_CONFIGPATH_DIR="$PWD/holmes"
export PATH="$PWD/.venv/bin:$PATH"
